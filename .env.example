# Root-level shared env for docker-compose + the API/bot/web apps.
# Copy this file to .env and fill in real values before running `make up`.
#
# Generate the random secrets with:
#   openssl rand -hex 32                 # BOT_BEARER_SECRET / SESSION_SECRET
#   openssl rand -hex 32                 # ENCRYPTION_KEY (must be 64 hex chars)

# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=discordbot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=discordbot
POSTGRES_PORT=5432

# Full URL the API uses inside the docker network. For local dev (no Docker),
# point at localhost instead.
DATABASE_URL=postgresql://discordbot:changeme@postgres:5432/discordbot?schema=public

# ─── Discord ───────────────────────────────────────────────────────────────
DISCORD_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=replace-with-application-client-id
DISCORD_CLIENT_SECRET=replace-with-application-client-secret
# Optional: scope slash-command deployments to a single guild during dev.
DEV_GUILD_ID=
# Where Discord sends users after OAuth login.
DISCORD_OAUTH_REDIRECT_URL=http://api.localhost/auth/discord/callback

# ─── API / Bot shared secrets ──────────────────────────────────────────────
# Bearer the bot uses to authenticate against the API. >= 32 chars.
BOT_BEARER_SECRET=replace-with-32-char-random
# Symmetric key for encrypting third-party tokens at rest. Exactly 64 hex chars.
ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32
# Web session cookie secret. >= 32 chars.
SESSION_SECRET=replace-with-32-char-random

# ─── Web ───────────────────────────────────────────────────────────────────
# Browser-visible API base URL (exposed via Next.js).
NEXT_PUBLIC_API_URL=http://api.localhost
# Origin the API will accept session cookies from (CORS + cookie domain).
WEB_ORIGIN=http://web.localhost
