# Root-level shared env. Per-app envs live in apps/*/.env.example.
# Copy this file to .env and fill in real values before running.

# ─── Postgres (used by docker-compose and apps/api) ───
POSTGRES_USER=discordbot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=discordbot
POSTGRES_PORT=5432

# Full URL the API uses to connect (matches the values above by default).
DATABASE_URL=postgresql://discordbot:changeme@localhost:5432/discordbot?schema=public
