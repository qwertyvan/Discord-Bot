{
  "name": "discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript Discord bot with admin web dashboard and shared REST API.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace @discord-bot/api",
    "dev:bot": "npm run dev --workspace @discord-bot/bot",
    "dev:web": "npm run dev --workspace @discord-bot/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace @discord-bot/api",
    "db:studio": "npm run prisma:studio --workspace @discord-bot/api"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
