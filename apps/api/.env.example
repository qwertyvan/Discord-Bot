# ─── Server ───
API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ───
DATABASE_URL=postgresql://discordbot:changeme@localhost:5432/discordbot?schema=public

# ─── Service auth (bot ↔ API) ───
# Long random string. Generate with: openssl rand -hex 32
BOT_API_TOKEN=replace-me-with-a-long-random-string

# ─── At-rest encryption ───
# 32 bytes hex used to envelope-encrypt persisted secrets (Discord OAuth
# access tokens, third-party API keys). Generate with: openssl rand -hex 32
# Rotating this requires re-encrypting every row that used the old value.
TOKEN_ENCRYPTION_KEY=replace-me-with-64-hex-chars

# ─── Web session ───
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-another-long-random-string
SESSION_COOKIE_NAME=db_session
# Lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# ─── Discord OAuth2 (web admin login) ───
# From https://discord.com/developers/applications → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URL=http://localhost:4000/auth/discord/callback

# ─── Web origin (for CORS) ───
WEB_ORIGIN=http://localhost:3000

# ─── Observability (all optional) ───
# When set, GET /metrics requires `Authorization: Bearer <token>`. Otherwise
# the endpoint is open — fine for an in-cluster Prometheus scrape.
# METRICS_TOKEN=
# OpenTelemetry OTLP/HTTP collector endpoint, e.g. http://localhost:4318.
# When set AND the optional @opentelemetry/* packages are installed, the API
# initializes the NodeSDK at boot. No-op otherwise.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=discord-bot-api
# Loki push endpoint, e.g. http://localhost:3100. When set, pino logs are
# batched and POSTed to /loki/api/v1/push every 5s. Failures are swallowed.
# LOG_LOKI_URL=
# LOG_LOKI_APP=discord-bot-api
# Seconds before the bot is considered stale on /health (default 90).
# BOT_HEARTBEAT_FRESH_SECONDS=90
