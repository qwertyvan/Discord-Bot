generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id      String   @id // Discord snowflake
  name    String
  iconUrl String?
  addedAt DateTime @default(now())

  welcome                WelcomeConfig?
  loggingConfig          LoggingConfig?
  warningPolicy          WarningPolicy?
  automodConfig          AutomodConfig?
  verificationConfig     VerificationConfig?
  modActions             ModAction[]
  modNotes               ModNote[]
  auditEvents            AuditEvent[]
  automodHits            AutomodHit[]
  reactionRolePanels     ReactionRolePanel[]
  polls                  Poll[]
  reminders              Reminder[]
  tags                   Tag[]
  autoResponses          AutoResponse[]
  levelConfig            LevelConfig?
  memberLevels           MemberLevel[]
  economyConfig          EconomyConfig?
  balances               Balance[]
  shopItems              ShopItem[]
  inventoryEntries       InventoryEntry[]
  ticketConfig           TicketConfig?
  ticketCategories       TicketCategory[]
  tickets                Ticket[]
  messageActivity        MessageActivity[]
  integrations           IntegrationSubscription[]
  integrationCredentials IntegrationCredential[]
  pendingPosts           PendingPost[]
  adminActions           AdminAction[]
  feedSubscriptions      FeedSubscription[]
  scheduledAnnouncements ScheduledAnnouncement[]
  birthdayConfig       BirthdayConfig?
  userBirthdays        UserBirthday[]
  events               Event[]
  customCommands       CustomCommand[]
  stickyMessages       StickyMessage[]
  suggestions          Suggestion[]
  giveaways            Giveaway[]
  starboardConfig      StarboardConfig?
  starboardEntries     StarboardEntry[]
  counterChannels      CounterChannel[]
  vanityRoles          VanityRole[]
  forumAutoTags        ForumAutoTag[]
  staleThreadPolicy    StaleThreadPolicy?
  stageScheduledEvents StageScheduledEvent[]
  reports              Report[]
  serverTemplates      ServerTemplate[]
  retentionPolicy      RetentionPolicy?
  dataExportJobs       DataExportJob[]
  dataDeleteRequests   DataDeleteRequest[]
  caseCounter          CaseCounter?
  voiceHubs            VoiceHubChannel[]
  voiceSessions        VoiceSession[]
  voiceClaimConfig     VoiceClaimConfig?
  voiceClaimable       VoiceClaimableChannel[]
  voiceClaims          VoiceClaim[]
  soundboardClips      SoundboardClip[]
  ttsConfig            TtsConfig?
  activitySnapshots    ActivitySnapshot[]
  channelDailyActivity ChannelDailyActivity[]
  memberActivity        MemberActivity[]
  activityRoleRules     ActivityRoleRule[]
  inactivityPrunePolicy InactivityPrunePolicy?
  antiRaidConfig        AntiRaidConfig?
  lockdownEvents        LockdownEvent[]
  pendingVerifications  PendingVerification[]
  triviaQuestions       TriviaQuestion[]
  triviaScores          TriviaScore[]
  hangmanGames          HangmanGame[]
  rpsRecords            RpsRecord[]
  rpsChallenges         RpsChallenge[]
  dailyStreaks          DailyStreak[]
  configSnapshots       ConfigSnapshot[]
  snapshotPolicy        SnapshotPolicy?
  warningLadderSteps    WarningLadderStep[]
  appeals               Appeal[]
  appealSlaConfig       AppealSlaConfig?
  outboundWebhooks      OutboundWebhook[]
  publicApiTokens       PublicApiToken[]
  musicQueue            MusicQueue?
  inviteCodes           InviteCode[]
  memberInvites         MemberInvite[]
  inviteGatedRoles      InviteGatedRole[]
  autoReactionRules     AutoReactionRule[]
  quoteConfig           QuoteConfig?
  quotes                Quote[]
  milestoneConfig       MilestoneConfig?
  tenureRoleRules       TenureRoleRule[]
  milestoneAwards       MilestoneAward[]
  lootDropsExt          LootDrop[]
  lootClaims            LootClaim[]
  fishingSkills         FishingSkill[]
  fishingDrops          FishingDrop[]
  fishingCasts          FishingCast[]
  linkSafetyConfig      LinkSafetyConfig?
  linkDomains           LinkDomain[]
  onboardingForms       OnboardingForm[]
  applications          Application[]
  karaokeNights         KaraokeNight[]
  auctions              Auction[]
  marketConfig          MarketConfig?
  marketListings        MarketListing[]
  questTemplates        QuestTemplate[]
  userQuests            UserQuest[]
  achievements          Achievement[]
  userAchievements      UserAchievement[]
  userProfiles          UserProfile[]
  profileBadges         ProfileBadge[]
  userBadges            UserBadge[]
  serverPet             ServerPet?
  petInteractions       PetInteraction[]
}

// Per-guild karaoke night — a host schedules it against a voice channel, the
// bot announces at T-15m / T-now, and members submit songs in advance. The
// host runs the queue live during the event.
model KaraokeNight {
  id                String    @id @default(uuid())
  guildId           String
  voiceChannelId    String
  hostId            String
  title             String    @db.VarChar(120)
  scheduledFor      DateTime
  status            String    @default("scheduled") @db.VarChar(16) // scheduled|live|ended|cancelled
  announceChannelId String?
  recapChannelId    String?
  announcedT15      Boolean   @default(false)
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime  @default(now())

  guild Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  songs KaraokeSong[]
  rsvps KaraokeRsvp[]

  @@index([guildId, status, scheduledFor])
}

model KaraokeSong {
  id          String    @id @default(uuid())
  nightId     String
  submitterId String
  title       String    @db.VarChar(200)
  url         String?   @db.VarChar(2048)
  notes       String?   @db.VarChar(500)
  playedAt    DateTime?
  position    Int
  createdAt   DateTime  @default(now())

  night KaraokeNight @relation(fields: [nightId], references: [id], onDelete: Cascade)

  @@index([nightId, position])
}

model KaraokeRsvp {
  nightId String
  userId  String
  status  String   @db.VarChar(8) // yes|maybe|no
  rsvpAt  DateTime @default(now())

  night KaraokeNight @relation(fields: [nightId], references: [id], onDelete: Cascade)

  @@id([nightId, userId])
}

// Per-guild quote-board settings. `savePermission` gates who can right-click
// "Save quote": "everyone" (no gate), "trusted-role" (must hold `trustedRoleId`),
// or "mods" (must have ManageMessages). `channelId` is where the weekly digest
// embed is posted when `weeklyDigest` is true.
model QuoteConfig {
  guildId        String   @id
  channelId      String?
  savePermission String   @default("everyone") @db.VarChar(16)
  trustedRoleId  String?
  weeklyDigest   Boolean  @default(false)

  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Per-guild member-milestone configuration. Drives the daily scheduler sweep
// that posts joinaversary embeds and the GuildMemberUpdate hook that grants
// boost rewards. `joinaversaryTemplate` supports {user}, {server}, {years}.
model MilestoneConfig {
  guildId                String   @id
  joinaversaryChannelId  String?
  joinaversaryTemplate   String?  @db.VarChar(500)
  joinaversaryReward     Int      @default(0)
  boostChannelId         String?
  boostRoleId            String?
  boostReward            Int      @default(0)
  enabled                Boolean  @default(false)
  updatedAt              DateTime @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// One saved quote. `reactionCount` is the snapshotted reactor count on the
// source message at save-time and can be bumped later by the bot; the weekly
// digest sorts by this. `savedBy` is the member who invoked "Save quote".
model Quote {
  id              String   @id @default(uuid())
  guildId         String
  sourceMessageId String
  sourceChannelId String
  authorId        String
  savedBy         String
  content         String   @db.VarChar(2000)
  attachmentUrl   String?  @db.VarChar(2048)
  savedAt         DateTime @default(now())
  reactionCount   Int      @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, sourceMessageId])
  @@index([guildId, savedAt])
}

// Auto-grant a role when a member crosses `daysRequired` of tenure in the
// guild. Reconciled by the daily milestone sweep.
model TenureRoleRule {
  id            String   @id @default(uuid())
  guildId       String
  roleId        String
  daysRequired  Int
  createdAt     DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, roleId])
  @@index([guildId, daysRequired])
}

// Idempotency ledger for milestone events so the daily sweep doesn't re-fire
// joinaversary posts or re-grant tenure roles on subsequent ticks. `kind`
// is one of: 'joinaversary' | 'boost' | 'tenure' | 'levelup'. The `payload`
// stores the year (joinaversary), rule id (tenure), or level (levelup).
model MilestoneAward {
  id          String   @id @default(uuid())
  guildId     String
  userId      String
  kind        String   @db.VarChar(32)
  payload     Json?
  awardedAt   DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, kind])
}

// Configured "join-to-create" hub voice channels. When a user joins one of
// these, the bot spawns a fresh child voice channel (cloned to the same
// category) for them and auto-deletes it once empty.
model VoiceHubChannel {
  guildId     String
  channelId   String   @unique
  namePattern String   @db.VarChar(64)
  userLimit   Int?
  categoryId  String?
  autoDelete  Boolean  @default(true)
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// Per-guild voice-claim configuration. When `enabled` is true, members can
// claim ownership of a voice channel via /vc claim. `mode = "all"` lets any
// voice channel be claimed; `mode = "listed"` restricts claiming to the
// channels listed in `VoiceClaimableChannel`.
model VoiceClaimConfig {
  guildId String  @id
  enabled Boolean @default(false)
  mode    String  @default("listed") @db.VarChar(16)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Curated allow-list of voice channels claimable via /vc claim. Only consulted
// when the parent VoiceClaimConfig.mode is "listed".
model VoiceClaimableChannel {
  guildId   String
  channelId String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, channelId])
  @@index([guildId])
}

// Active claim on a voice channel. One row per claimed channel; the owner has
// /vc rename / limit / kick / lock / unlock controls while present. The bot
// auto-clears the claim when the owner leaves for >60s or the channel empties.
model VoiceClaim {
  guildId   String
  channelId String
  ownerId   String
  claimedAt DateTime  @default(now())
  lockedAt  DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, channelId])
  @@index([guildId])
}

// Per-(guild, user) running activity totals used by activity-role rules and
// the inactivity-prune policy. The bot increments these via a 60-second
// batched flush; `lastActiveAt` is touched on every message and voice-minute
// award so the prune policy can identify members idle for N days.
model MemberActivity {
  guildId      String
  userId       String
  messages     Int      @default(0)
  voiceMinutes Int      @default(0)
  lastActiveAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, lastActiveAt])
}

// A rule that grants or revokes a Discord role based on whether a member's
// activity over the last `windowDays` meets the configured thresholds. The
// bot's daily scheduler evaluates every enabled rule and reconciles role
// membership accordingly.
model ActivityRoleRule {
  id              String   @id @default(uuid())
  guildId         String
  roleId          String
  minMessages     Int      @default(0)
  minVoiceMinutes Int      @default(0)
  windowDays      Int      @default(30)
  // 'grant' adds the role when the member meets the thresholds; 'revoke'
  // removes the role when they meet the thresholds (i.e. a "minimum-activity
  // demotion" gate).
  action          String   @db.VarChar(16)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// One row per active (or recently-ended) voice session. Open sessions have
// `leftAt = null`; the scheduler reads these to award per-minute voice XP.
model VoiceSession {
  id         String    @id @default(uuid())
  guildId    String
  userId     String
  channelId  String
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?

  guild      Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, leftAt])
}

// Per-guild soundboard library. Each clip is a named URL pointing to a
// playable audio source (mp3/ogg/etc.) that the bot streams into a voice
// channel via `@discordjs/voice` when available.
model SoundboardClip {
  id          String   @id @default(uuid())
  guildId     String
  name        String   @db.VarChar(64)
  url         String   @db.VarChar(2048)
  uploaderId  String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId])
}

// Per-guild TTS announcement configuration. Welcome/goodbye text is spoken
// into `voiceChannelId` using the Google Translate TTS endpoint (no API key
// required) when `enabled` is true.
model TtsConfig {
  guildId        String   @id
  welcomeText    String?  @db.VarChar(500)
  goodbyeText    String?  @db.VarChar(500)
  voiceChannelId String?
  language       String   @default("en") @db.VarChar(8)
  enabled        Boolean  @default(false)

  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Per-guild daily aggregate of join/leave/message/voice activity. The bot
// keeps an in-memory tally and flushes deltas to the API roughly every 60s.
// One row per (guildId, day-in-UTC).
model ActivitySnapshot {
  guildId       String
  day           DateTime @db.Date
  joins         Int      @default(0)
  leaves        Int      @default(0)
  messages      Int      @default(0)
  voiceMinutes  Int      @default(0)

  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, day])
  @@index([guildId])
}

// Per-(guild, channel, day) message counter feeding the "top channels"
// section of the insights dashboard. Flushed alongside ActivitySnapshot.
model ChannelDailyActivity {
  guildId   String
  channelId String
  day       DateTime @db.Date
  messages  Int      @default(0)

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, channelId, day])
  @@index([guildId])
}

// Optional per-guild policy: members inactive for `inactiveDays` may be
// kicked. Evaluated on demand via `/prune preview` and `/prune run`; never
// runs automatically unless `enabled` is true.
model InactivityPrunePolicy {
  guildId        String   @id
  enabled        Boolean  @default(false)
  inactiveDays   Int      @default(60)
  excludeRoleIds String[] @default([])
  notifyDm       Boolean  @default(true)
  updatedAt      DateTime @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Anti-raid + captcha configuration for a guild. The bot tracks join velocity
// in memory and, when joinsPerMinute > joinsPerMinuteThreshold, opens a
// LockdownEvent. While a lockdown is active, subsequent joiners are kicked
// (or quarantined under unverifiedRoleId if captchaRequired is on and
// available). When captchaRequired is on, every join generates a
// PendingVerification challenge (math or image) that the user must solve via
// /verify before the verified role is granted.
model AntiRaidConfig {
  guildId                 String   @id
  enabled                 Boolean  @default(false)
  joinsPerMinuteThreshold Int      @default(8)
  lockdownDurationMin     Int      @default(30)
  captchaRequired         Boolean  @default(false)
  captchaKind             String   @default("math") @db.VarChar(16)
  riskScoreThreshold      Int      @default(50)
  unverifiedRoleId        String?
  updatedAt               DateTime @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// ─── Mini-games (v0.25.0) ───────────────────────────────────────────

model TriviaQuestion {
  id           String   @id @default(uuid())
  guildId      String
  prompt       String   @db.VarChar(500)
  choices      String[]
  correctIndex Int
  category     String?  @db.VarChar(64)
  createdBy    String
  createdAt    DateTime @default(now())

  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, category])
}

model TriviaScore {
  guildId  String
  userId   String
  correct  Int    @default(0)
  total    Int    @default(0)

  guild    Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, correct(sort: Desc)])
}

model HangmanGame {
  id         String   @id @default(uuid())
  guildId    String
  channelId  String
  hostId     String
  word       String   @db.VarChar(64)
  revealed   String   @db.VarChar(64)
  misses     String   @default("") @db.VarChar(32)
  maxMisses  Int      @default(6)
  messageId  String?
  // 'active' | 'won' | 'lost' | 'abandoned'
  status     String   @default("active") @db.VarChar(16)
  createdAt  DateTime @default(now())

  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([channelId, status])
}

model RpsRecord {
  guildId  String
  userId   String
  wins     Int    @default(0)
  losses   Int    @default(0)
  draws    Int    @default(0)
  elo      Int    @default(1000)

  guild    Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, elo(sort: Desc)])
}

model RpsChallenge {
  id               String   @id @default(uuid())
  guildId          String
  channelId        String
  challengerId     String
  opponentId       String
  challengerChoice String?  @db.VarChar(16)
  opponentChoice   String?  @db.VarChar(16)
  // 'open' | 'resolved' | 'cancelled'
  status           String   @default("open") @db.VarChar(16)
  createdAt        DateTime @default(now())

  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([opponentId, status])
}

model DailyStreak {
  guildId      String
  userId       String
  streak       Int       @default(0)
  lastClaimAt  DateTime?

  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, streak(sort: Desc)])
}

// Periodic JSON snapshot of all guild-scoped CONFIG tables. `payload` is a
// JSON object keyed by Prisma model name, with each value the array of rows
// for that model belonging to this guild. User data tables (XP rows, ticket
// content, balances, audit log, etc.) are intentionally excluded.
model ConfigSnapshot {
  id         String   @id @default(uuid())
  guildId    String
  createdAt  DateTime @default(now())
  label      String   @db.VarChar(120)
  payload    Json
  sizeBytes  Int
  createdBy  String?

  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}

// Per-guild snapshot scheduling policy. When `autoEnabled` is true the bot's
// daily scheduler tick creates a fresh snapshot and prunes any older than
// `retentionDays`.
model SnapshotPolicy {
  guildId        String   @id
  autoEnabled    Boolean  @default(false)
  retentionDays  Int      @default(30)
  updatedAt      DateTime @updatedAt @default(now())

  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Configurable per-guild warning escalation ladder. After each warning the
// API picks the highest threshold ≤ active warn count and tells the bot to
// apply `action` (mute / kick / ban). `durationMinutes` is honoured only for
// `mute` (mapped to Discord timeout).
model WarningLadderStep {
  id              String  @id @default(uuid())
  guildId         String
  threshold       Int
  action          String  @db.VarChar(16) // 'mute' | 'kick' | 'ban'
  durationMinutes Int?

  guild           Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, threshold])
  @@index([guildId])
}

// User-submitted appeal against a moderation action (or a generic appeal).
// Reviewed by staff with a note + DM back to the user.
model Appeal {
  id           String    @id @default(uuid())
  guildId      String
  userId       String
  modActionId  String?
  message      String    @db.VarChar(2000)
  // 'open' | 'approved' | 'denied'
  status       String    @default("open") @db.VarChar(16)
  reviewNote   String?   @db.VarChar(500)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status, createdAt])
}

// Per-guild appeal SLA config: open appeals older than `warnHours` get a
// reminder embed posted to `escalateChannelId` (if set) on each hourly tick.
model AppealSlaConfig {
  guildId           String  @id
  warnHours         Int     @default(24)
  escalateChannelId String?

  guild             Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Per-guild outbound webhook subscription. The API enqueues a
// WebhookDelivery row for each active webhook subscribed to an event type
// when dispatchEvent() is called; a background worker drains the queue and
// signs deliveries with HMAC-SHA256.
model OutboundWebhook {
  id              String   @id @default(uuid())
  guildId         String
  url             String   @db.VarChar(2048)
  // Envelope-encrypted via crypto.ts (v1:...). HMAC key for outgoing deliveries.
  secretEncrypted String   @db.VarChar(2048)
  // Subscribed event names (e.g. "modaction.created", "ticket.opened").
  events          String[]
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  lastDeliveryAt  DateTime?
  lastStatus      Int?

  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([guildId, active])
}

// A pending or completed outbound webhook delivery. Status 0 = queued,
// 2xx/3xx = delivered, 4xx/5xx = transient failure (retried with backoff),
// -1 = permanently failed (max attempts exceeded).
model WebhookDelivery {
  id           String   @id @default(uuid())
  webhookId    String
  eventType    String   @db.VarChar(64)
  payload      Json
  status       Int      @default(0)
  attemptCount Int      @default(0)
  deliveredAt  DateTime?
  nextRetryAt  DateTime?
  createdAt    DateTime @default(now())

  webhook      OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, deliveredAt])
  @@index([nextRetryAt])
}

// Per-guild public API token. The plaintext is only returned once on
// creation; we persist a SHA-256 hash so requests are looked up by hash.
// Scopes (e.g. "stats:read") gate access to /public/* routes.
model PublicApiToken {
  id          String   @id @default(uuid())
  guildId     String
  name        String   @db.VarChar(64)
  tokenHash   String   @db.VarChar(128) @unique
  scopes      String[]
  createdBy   String
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// Per-guild music playback state. One row per guild. Tracks belong to this
// queue via MusicTrack.guildId. Survives bot restarts so the queue isn't
// lost on deploy; the bot picks up from currentIndex on resume.
model MusicQueue {
  guildId      String   @id
  // Voice channel the bot is connected to (or last connected to).
  channelId    String?
  // Position within the tracks list the player is currently on.
  currentIndex Int      @default(0)
  // Player volume 0-100.
  volume       Int      @default(50)
  // 'off' | 'track' | 'queue'.
  loopMode     String   @default("off") @db.VarChar(8)
  updatedAt    DateTime @updatedAt

  guild       Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  musicTracks MusicTrack[]
}

model MusicTrack {
  id          String   @id @default(uuid())
  guildId     String
  // Display order within the queue. The bot keeps this contiguous starting at 0.
  position    Int
  title       String   @db.VarChar(300)
  url         String   @db.VarChar(2048)
  durationSec Int?
  requesterId String
  addedAt     DateTime @default(now())

  queue MusicQueue @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, position])
}

// Voice/text channel whose name is periodically rewritten to reflect a live
// guild statistic (member count, online count, boosts, etc.). Discord
// rate-limits channel renames at 2 per 10 minutes; the bot scheduler ticks
// every 5 minutes and tolerates failed renames.
model CounterChannel {
  guildId   String
  channelId String   @unique
  // 'members' | 'humans' | 'bots' | 'online' | 'boosts'
  type      String   @db.VarChar(16)
  template  String   @default("Members: {count}") @db.VarChar(64)
  updatedAt DateTime @updatedAt

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// Per-guild catalogue of self-service vanity roles (typically "color" roles).
// /color pick swaps the user's existing color role for the chosen one;
// mutual exclusivity is enforced per kind.
model VanityRole {
  id        String   @id @default(uuid())
  guildId   String
  roleId    String
  name      String   @db.VarChar(64)
  // 'color' | 'badge'
  kind      String   @db.VarChar(16)
  hexColor  String?  @db.VarChar(7)
  emoji     String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, kind])
}

// Per-forum-channel keyword-to-tag rule. The bot scans the first message of
// a newly-created forum thread; any rule whose `keyword` (lower-cased) appears
// as a substring applies its `tagId` to the thread's applied tags.
model ForumAutoTag {
  id        String   @id @default(uuid())
  guildId   String
  channelId String
  keyword   String   @db.VarChar(120)
  tagId     String
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([channelId, keyword])
  @@index([guildId])
}

// Per-guild stale-thread policy. The bot's hourly sweep walks forum channels
// in the guild; threads whose lastMessage is older than `idleHours` are either
// archived or locked depending on `action`.
model StaleThreadPolicy {
  guildId   String   @id
  enabled   Boolean  @default(false)
  idleHours Int      @default(72)
  // 'archive' | 'lock'
  action    String   @default("archive") @db.VarChar(16)
  updatedAt DateTime @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Persistent record of a scheduled Stage session. The bot scheduler creates
// a StageInstance at `scheduledFor`, flips status to 'live', then to 'ended'
// once the stage closes (posting a recap embed to `recapChannelId` if set).
model StageScheduledEvent {
  id             String   @id @default(uuid())
  guildId        String
  channelId      String
  topic          String   @db.VarChar(120)
  scheduledFor   DateTime
  speakerIds     String[] @default([])
  recapChannelId String?
  // 'scheduled' | 'live' | 'ended' | 'cancelled'
  status         String   @default("scheduled") @db.VarChar(16)
  createdAt      DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status, scheduledFor])
}

// One row per lockdown window. `endedAt` null = active. `trigger` is a short
// human-readable label ("auto: 12 joins/min", "manual: by Alice"). `joinsBlocked`
// is bumped by the bot each time it kicks a joiner during the lockdown.
model LockdownEvent {
  id           String    @id @default(uuid())
  guildId      String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  trigger      String    @db.VarChar(64)
  joinsBlocked Int       @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, startedAt])
}

// A captcha challenge issued to a joining user. The bot DMs the challenge,
// the user replies via /verify <answer>. Expired rows are reaped by the
// scheduler.
model PendingVerification {
  guildId       String
  userId        String
  challengeKind String   @db.VarChar(16)
  challenge     String   @db.VarChar(200)
  answer        String   @db.VarChar(64)
  attemptsLeft  Int      @default(3)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
}

// Captured guild topology (roles + channels + overwrites) saved as a
// versioned, optionally public template. Applied to other guilds to clone
// the structural shape (no member data, no message history).
model ServerTemplate {
  id            String   @id @default(uuid())
  ownerGuildId  String
  name          String   @db.VarChar(120)
  description   String?  @db.VarChar(500)
  payload       Json
  version       Int      @default(1)
  public        Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerGuild    Guild    @relation(fields: [ownerGuildId], references: [id], onDelete: Cascade)

  @@index([ownerGuildId])
  @@index([public])
}

// Channel-pinned "sticky" message: the bot reposts it to the bottom every
// `throttleMessages` user messages. One sticky per channel max.
model StickyMessage {
  guildId          String
  channelId        String   @unique
  content          String   @db.VarChar(2000)
  // The currently-posted message id in Discord so the bot can delete the
  // previous instance before reposting.
  lastMessageId    String?
  throttleMessages Int      @default(5)
  enabled          Boolean  @default(true)
  updatedAt        DateTime @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, channelId])
  @@index([guildId])
}

model Suggestion {
  id         String    @id @default(uuid())
  guildId    String
  channelId  String
  messageId  String?
  authorId   String
  content    String    @db.VarChar(2000)
  // 'open' | 'accepted' | 'rejected' | 'implemented'
  status     String    @default("open") @db.VarChar(16)
  reviewNote String?   @db.VarChar(500)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  guild Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  votes SuggestionVote[]

  @@index([guildId, status, createdAt])
}

model SuggestionVote {
  suggestionId String
  userId       String
  // 1 = upvote, -1 = downvote
  vote         Int
  createdAt    DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@id([suggestionId, userId])
}

// Timed giveaways. Members enter via the embed's single "Enter" button; on
// `endsAt` the scheduler asks the API to draw `winnerCount` winners weighted
// by `weight` (number of `weightedBonusRoles` the user holds + 1). Status:
// 'active' | 'ended' | 'cancelled'.
model Giveaway {
  id                   String   @id @default(uuid())
  guildId              String
  channelId            String
  messageId            String?
  prize                String   @db.VarChar(200)
  hostId               String
  endsAt               DateTime
  winnerCount          Int      @default(1)
  requireRoleId        String?
  requireMinLevel      Int?
  weightedBonusRoles   String[] @default([])
  status               String   @default("active") @db.VarChar(16)
  createdAt            DateTime @default(now())

  guild                Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  entries              GiveawayEntry[]
  winners              GiveawayWinner[]

  @@index([guildId, status])
  @@index([status, endsAt])
}

model GiveawayEntry {
  giveawayId  String
  userId      String
  weight      Int      @default(1)
  createdAt   DateTime @default(now())

  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@id([giveawayId, userId])
}

model GiveawayWinner {
  id          String   @id @default(uuid())
  giveawayId  String
  userId      String
  drawAt      DateTime @default(now())

  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@index([giveawayId])
}

// Member-filed report against a message or user. Lands in a per-guild
// mod queue, where staff review and either dismiss or take action
// (warn / mute / delete the source message).
model Report {
  id              String    @id @default(uuid())
  guildId         String
  reporterId      String
  targetUserId    String
  targetMessageId String?
  channelId       String
  content         String    @db.VarChar(2000)
  // 'open' | 'reviewed'
  status          String    @default("open") @db.VarChar(16)
  reviewedBy      String?
  reviewedAt      DateTime?
  // 'warn' | 'mute' | 'delete' | 'dismiss'
  actionTaken     String?   @db.VarChar(32)
  reviewNote      String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())

  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status, createdAt])
}

// React-to-pin: when a message gets `threshold` distinct reactions of `emoji`,
// the bot mirrors it to `channelId` as a starboard entry. NSFW source channels
// are skipped unless `allowNsfw` is set.
model StarboardConfig {
  guildId    String   @id
  channelId  String?
  threshold  Int      @default(3)
  emoji      String   @default("⭐") @db.VarChar(64)
  allowNsfw  Boolean  @default(false)
  enabled    Boolean  @default(false)
  updatedAt  DateTime @updatedAt @default(now())

  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// One row per source message ever pinned by the starboard. `starboardMessageId`
// is null until the threshold is first met; afterwards the bot edits that
// message as the star count grows.
model StarboardEntry {
  sourceMessageId    String   @id
  starboardMessageId String?
  guildId            String
  authorId           String
  channelId          String
  starCount          Int      @default(0)
  content            String   @db.VarChar(2000)
  attachmentUrl      String?  @db.VarChar(2048)
  firstStarredAt     DateTime @default(now())

  guild              Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, starCount])
}

model ScheduledAnnouncement {
  id          String    @id @default(uuid())
  guildId     String
  channelId   String
  content     String?   @db.VarChar(2000)
  embedJson   Json?
  runAt       DateTime
  // When set, re-fires every N seconds and runAt advances on each firing.
  repeatEvery Int?
  lastRunAt   DateTime?
  enabled     Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([enabled, runAt])
  @@index([guildId, runAt])
}

model BirthdayConfig {
  guildId           String    @id
  enabled           Boolean   @default(false)
  channelId         String?
  template          String?   @db.VarChar(500)
  announceHour      Int       @default(12)
  lastAnnouncedDate DateTime? @db.Date
  updatedAt         DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model UserBirthday {
  guildId   String
  userId    String
  month     Int
  day       Int
  year      Int?
  updatedAt DateTime @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, month, day])
}

model Event {
  id          String    @id @default(uuid())
  guildId     String
  channelId   String
  messageId   String?
  title       String    @db.VarChar(200)
  description String?   @db.VarChar(2000)
  startsAt    DateTime
  endsAt      DateTime?
  location    String?   @db.VarChar(200)
  createdBy   String
  createdAt   DateTime  @default(now())

  guild Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  rsvps EventRsvp[]

  @@index([guildId, startsAt])
}

model EventRsvp {
  eventId     String
  userId      String
  status      String   @db.VarChar(8)
  respondedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([eventId])
}

// Each session-authed mutation through /admin/* is recorded here so the
// dashboard can show "X enabled automod" / "Y deleted ticket category Z"
// and trace config changes over time.
model AdminAction {
  id        String   @id @default(uuid())
  guildId   String?
  userId    String
  method    String   @db.VarChar(8)
  path      String   @db.VarChar(256)
  summary   Json     @default("{}")
  status    Int
  createdAt DateTime @default(now())

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt])
  @@index([userId, createdAt])
}

model UserTimezone {
  userId    String   @id
  tz        String   @db.VarChar(64)
  updatedAt DateTime @updatedAt
}

// Per-guild custom slash commands. The bot syncs Discord's guild command
// registration when these change. The response supports the same template
// variables as tags: {user}, {server}, {memberCount}, {random:a,b,c}.
model CustomCommand {
  id          String   @id @default(uuid())
  guildId     String
  name        String   @db.VarChar(32)
  description String   @db.VarChar(100)
  response    String   @db.VarChar(2000)
  createdBy   String
  uses        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId])
}

// Self-hosted URL shortener entries. `slug` is the path served by
// `/s/:slug` (302 → target, increments `uses`).
model ShortLink {
  id        String   @id @default(uuid())
  slug      String   @unique @db.VarChar(32)
  guildId   String?
  target    String   @db.VarChar(2048)
  createdBy String
  uses      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([slug])
}

model IntegrationSubscription {
  id             String    @id @default(uuid())
  guildId        String
  channelId      String
  name           String    @db.VarChar(80)
  // 'rss' | 'webhook' | 'twitch'.
  kind           String    @db.VarChar(16)
  // RSS-only:
  rssUrl         String?
  lastSeenGuid   String?
  lastPolledAt   DateTime?
  pollInterval   Int       @default(600)
  // Webhook-only:
  token          String?   @unique
  secret         String?
  // Twitch-only (login name, e.g. "shroud").
  twitchUsername String?
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([kind, enabled, lastPolledAt])
}

// Per-guild API credentials for external providers (Twitch, Sightengine,
// DeepL, etc.). Values are envelope-encrypted via crypto.ts before storage.
// `provider` + `key` form a per-guild composite (e.g. provider='twitch',
// key='client_id').
model IntegrationCredential {
  guildId   String
  provider  String   @db.VarChar(32)
  key       String   @db.VarChar(32)
  value     String // encrypted
  updatedAt DateTime @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, provider, key])
  @@index([guildId, provider])
}

// Public-feed subscriptions (YouTube uploads, Reddit, Bluesky, Mastodon).
// Polled by the bot every ~5min; new items are queued via PendingPost.
// `identifier` is the kind-specific handle: a YouTube channel id
// ("UCxxxx"), a subreddit name ("typescript"), a Bluesky handle
// ("alice.bsky.social"), or a Mastodon address ("@user@instance.tld").
// `lastItemId` tracks the most recently posted item so the next tick
// can diff incrementally.
model FeedSubscription {
  id           String   @id @default(uuid())
  guildId      String
  // 'youtube' | 'reddit' | 'bluesky' | 'mastodon'
  kind         String   @db.VarChar(16)
  identifier   String   @db.VarChar(200)
  channelId    String
  template     String?  @db.VarChar(500)
  lastItemId   String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())

  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, kind])
  @@index([kind, enabled])
}

// Queue of messages to be posted by the bot. Populated by webhook ingress
// and RSS polling; the bot drains the queue on its scheduler tick.
model PendingPost {
  id        String   @id @default(uuid())
  guildId   String
  channelId String
  content   String?  @db.VarChar(2000)
  embedJson Json?
  // Source label for attribution.
  source    String?  @db.VarChar(80)
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// Per-(channel, day, hour) message counters. The bot keeps an in-memory tally
// in messageCreate and flushes deltas to the API every ~60 seconds. Stats
// endpoints (heatmap, totals) read this rollup.
model MessageActivity {
  guildId   String
  channelId String
  date      DateTime @db.Date
  hour      Int
  count     Int      @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, channelId, date, hour])
  @@index([guildId, date])
}

model TicketConfig {
  guildId              String   @id
  enabled              Boolean  @default(false)
  panelChannelId       String?
  panelMessageId       String?
  staffRoleId          String?
  defaultSlaSeconds    Int?
  transcriptChannelId  String?
  // Seconds of staff silence after the user's last message before the bot
  // pings the staff role with an SLA reminder. Null disables.
  slaReminderSeconds   Int?
  // Seconds of total ticket-thread inactivity before the bot auto-closes.
  // Null disables.
  idleAutoCloseSeconds Int?
  // When true, on close the bot uploads an HTML transcript to
  // transcriptChannelId (or the ticket thread if not set).
  transcriptsEnabled   Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model TicketCategory {
  id          String   @id @default(uuid())
  guildId     String
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  emoji       String?  @db.VarChar(64)
  staffRoleId String?
  slaSeconds  Int?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([guildId, name])
  @@index([guildId, position])
}

model Ticket {
  id             String    @id @default(uuid())
  guildId        String
  categoryId     String?
  userId         String
  channelId      String
  number         Int
  status         String    @default("open") @db.VarChar(16)
  subject        String?   @db.VarChar(200)
  assignedTo     String?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  closedBy       String?
  closeReason    String?   @db.VarChar(500)
  // Updated whenever a message is posted in the ticket thread.
  lastActivityAt DateTime?
  // Set when the bot fires the SLA-reminder ping so we don't re-fire.
  slaReminderAt  DateTime?

  guild    Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  category TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([guildId, number])
  @@index([guildId, status, openedAt])
  @@index([guildId, userId, openedAt])
  @@index([status, lastActivityAt])
}

model EconomyConfig {
  guildId              String   @id
  enabled              Boolean  @default(false)
  currencyName         String   @default("coins")
  currencySymbol       String   @default("🪙")
  startingBalance      Int      @default(0)
  dailyReward          Int      @default(100)
  dailyCooldownSeconds Int      @default(86400)
  workMin              Int      @default(20)
  workMax              Int      @default(80)
  workCooldownSeconds  Int      @default(3600)
  gamblingEnabled      Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model Balance {
  guildId     String
  userId      String
  amount      Int       @default(0)
  lastDailyAt DateTime?
  lastWorkAt  DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, amount(sort: Desc)])
}

model ShopItem {
  id          String   @id @default(uuid())
  guildId     String
  // Stable per-guild identifier used for command autocompletion and lookup.
  slug        String   @db.VarChar(48)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  // Item cost in the guild's currency (uses Int to stay consistent with
  // Balance.amount; the field is named priceCents for compatibility with the
  // shared schema even though the unit is the guild's currency).
  price       Int
  // 'consumable' | 'role' | 'badge' | 'cosmetic'. Legacy 'virtual' rows still
  // resolve as consumable-equivalent.
  kind        String   @default("consumable") @db.VarChar(16)
  roleId      String?
  // Optional flavour message shown on /use for consumable-type items.
  message     String?  @db.VarChar(2000)
  // null = unlimited stock.
  stock       Int?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  guild          Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  inventory      InventoryEntry[]
  lootDrops      LootDrop[]
  marketListings MarketListing[]
  auctions       Auction[]
  fishingDrops   FishingDrop[]

  @@unique([guildId, slug])
  @@unique([guildId, name])
  @@index([guildId])
  @@index([guildId, enabled])
}

model InventoryEntry {
  guildId     String
  userId      String
  itemId      String
  quantity    Int      @default(1)
  acquiredAt  DateTime @default(now())

  guild Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  item  ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([guildId, userId, itemId])
  @@index([guildId, userId])
}

// Configurable per-guild crate table. Each row is one possible drop. The
// /loot command performs a weighted random pick across enabled rows.
// A drop yields either an item (itemId) or a currency reward (a random
// integer in [currencyMin, currencyMax]); both may be set, in which case
// both are awarded.
model LootDrop {
  id           String  @id @default(uuid())
  guildId      String
  slug         String  @db.VarChar(48)
  itemId       String?
  currencyMin  Int     @default(0)
  currencyMax  Int     @default(0)
  weight       Int     @default(1)

  guild Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  item  ShopItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([guildId, slug])
  @@index([guildId])
}

// Cooldown / streak tracking for the /loot daily crate.
model LootClaim {
  guildId      String
  userId       String
  lastClaimAt  DateTime?
  streak       Int       @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
}

model LevelConfig {
  guildId             String   @id
  enabled             Boolean  @default(false)
  // XP awarded for each non-bot message (subject to cooldown).
  perMessageXp        Int      @default(15)
  // Minimum seconds between XP-eligible messages from the same user.
  textCooldownSeconds Int      @default(60)
  // XP awarded per minute of voice activity.
  voiceXpPerMinute      Int      @default(5)
  // Master switch for the per-minute voice-XP scheduler. When false, the bot
  // still tracks sessions but doesn't award XP for them.
  voiceXpEnabled        Boolean  @default(false)
  // Channel for level-up announcements; null = reply in-place.
  levelUpChannelId    String?
  // Defaults to "🎉 {user} just reached level {level}!".
  levelUpTemplate     String?
  // JSON: { "channelId": multiplier (number) }
  channelMultipliers  Json     @default("{}")
  // JSON: [{ "level": N, "roleId": "..." }]
  roleRewards         Json     @default("[]")
  // JSON: array of role IDs whose members don't earn XP.
  noXpRoleIds         Json     @default("[]")
  // When true, /rank attaches a rendered PNG card instead of an embed.
  rankCardEnabled     Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model MemberLevel {
  guildId      String
  userId       String
  xp           Int       @default(0)
  lastTextXpAt DateTime?
  voiceMinutes Int       @default(0)
  updatedAt    DateTime  @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, xp(sort: Desc)])
}

model Poll {
  id          String    @id @default(uuid())
  guildId     String
  channelId   String
  messageId   String?
  authorId    String
  question    String    @db.VarChar(300)
  anonymous   Boolean   @default(false)
  multiSelect Boolean   @default(false)
  closesAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  guild   Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([guildId, createdAt])
  @@index([closesAt])
}

model PollOption {
  id       String @id @default(uuid())
  pollId   String
  label    String @db.VarChar(80)
  position Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId, position])
}

model PollVote {
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([pollId, optionId, userId])
  @@index([pollId, userId])
}

model Reminder {
  id        String   @id @default(uuid())
  guildId   String? // null = DM reminder
  userId    String
  channelId String? // null = DM the user
  content   String   @db.VarChar(500)
  runAt     DateTime
  createdAt DateTime @default(now())

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([runAt])
  @@index([userId, runAt])
}

model Tag {
  id        String   @id @default(uuid())
  guildId   String
  name      String   @db.VarChar(64)
  content   String   @db.VarChar(2000)
  authorId  String
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId])
}

model AutoResponse {
  id            String   @id @default(uuid())
  guildId       String
  trigger       String   @db.VarChar(200)
  // "contains" matches substring; "word" matches whole word; "exact" matches whole message.
  matchType     String   @default("contains") @db.VarChar(16)
  caseSensitive Boolean  @default(false)
  response      String   @db.VarChar(2000)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model VerificationConfig {
  guildId        String   @id
  enabled        Boolean  @default(false)
  channelId      String? // where the verify button is posted
  messageId      String? // the message that hosts the button
  verifiedRoleId String?
  buttonLabel    String? // defaults to "Verify"
  prompt         String? // header / instruction text
  updatedAt      DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model ReactionRolePanel {
  id          String   @id @default(uuid())
  guildId     String
  channelId   String
  messageId   String? // null until the panel is posted
  name        String
  description String?
  // When true, picking one option removes the others' roles.
  exclusive   Boolean  @default(false)
  // Render as a dropdown instead of buttons (forced when > 5 options).
  useDropdown Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild   Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  options ReactionRoleOption[]

  @@unique([guildId, name])
  @@index([guildId])
}

model ReactionRoleOption {
  id          String  @id @default(uuid())
  panelId     String
  roleId      String
  label       String
  description String?
  // Unicode emoji or "<a?:name:id>" custom-emoji syntax.
  emoji       String?
  // Display order within the panel.
  position    Int     @default(0)

  panel ReactionRolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId, position])
}

model AutomodConfig {
  guildId          String   @id
  enabled          Boolean  @default(false)
  // Roles whose members bypass all automod rules.
  exemptRoleIds    Json     @default("[]")
  // Channels whose messages skip automod entirely.
  exemptChannelIds Json     @default("[]")
  // Per-rule configuration. See packages/shared/src/automod.ts for the schema.
  rules            Json     @default("{}")
  updatedAt        DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model AutomodHit {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  channelId String?
  rule      String // rule key (e.g. "antispam", "antiinvite")
  action    String // action taken (DELETE, WARN, TIMEOUT, KICK, BAN, NONE)
  reason    String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, userId, createdAt])
  @@index([guildId, rule, createdAt])
}

model WelcomeConfig {
  guildId           String   @id
  enabled           Boolean  @default(false)
  channelId         String?
  joinTemplate      String?
  leaveTemplate     String?
  // Optional DM sent to the joining member (separate from the channel message).
  dmTemplate        String?
  // Roles assigned automatically to every new member.
  autoRoleIds       Json     @default("[]")
  // Announce milestones (e.g. every 100 members). null disables.
  milestoneEvery    Int?
  milestoneTemplate String?
  // When true, the join message includes a rendered welcome card (PNG).
  cardEnabled       Boolean  @default(false)
  // Optional background image URL (fetched by the bot at render time).
  cardBackgroundUrl String?
  updatedAt         DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Unified moderation action log. Every kick/ban/timeout/warn/etc. produces
// exactly one row here, carrying a per-guild sequential case number so
// humans can reference actions by `#42` style IDs in conversation.
model ModAction {
  id          String        @id @default(uuid())
  guildId     String
  caseNumber  Int
  type        ModActionType
  userId      String // target user
  moderatorId String
  reason      String        @db.VarChar(500)
  // Optional structured fields per action type.
  durationMs  Int? // timeout / mute duration
  expiresAt   DateTime? // when the action lapses (warnings, timeouts)
  category    String? // freeform category for warnings/notes
  severity    Int?          @default(1)
  active      Boolean       @default(true) // false when superseded/expired/deleted
  createdAt   DateTime      @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, caseNumber])
  @@index([guildId, createdAt])
  @@index([guildId, userId, createdAt])
  @@index([guildId, type])
}

enum ModActionType {
  WARN
  KICK
  BAN
  UNBAN
  SOFTBAN
  TIMEOUT
  UNTIMEOUT
  MUTE
  UNMUTE
  NOTE
}

// Per-guild monotonically-increasing case counter. Held in its own table so we
// can atomically increment without locking the entire ModAction table.
model CaseCounter {
  guildId String @id
  next    Int    @default(1)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Private mod-only notes about a user. Not visible to the user themselves.
model ModNote {
  id          String   @id @default(uuid())
  guildId     String
  userId      String
  moderatorId String
  content     String   @db.VarChar(1000)
  createdAt   DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, createdAt])
}

// Per-guild logging configuration. `events` is a JSON object mapping
// AuditEventType → boolean; missing keys default to true.
model LoggingConfig {
  guildId   String   @id
  enabled   Boolean  @default(false)
  channelId String?
  events    Json     @default("{}")
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String         @id @default(uuid())
  guildId   String
  type      AuditEventType
  userId    String?
  channelId String?
  payload   Json           @default("{}")
  createdAt DateTime       @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, type, createdAt])
  @@index([guildId, userId, createdAt])
}

enum AuditEventType {
  MESSAGE_DELETE
  MESSAGE_EDIT
  MEMBER_JOIN
  MEMBER_LEAVE
  MEMBER_ROLE_ADD
  MEMBER_ROLE_REMOVE
  MEMBER_NICKNAME_CHANGE
  CHANNEL_CREATE
  CHANNEL_DELETE
  VOICE_JOIN
  VOICE_LEAVE
  MOD_ACTION
}

// Warning policy: auto-expiry and threshold-based escalation.
// `thresholds` is a JSON array of { count, action, durationMs? }.
model WarningPolicy {
  guildId    String   @id
  expireDays Int? // warnings older than this are marked inactive
  thresholds Json     @default("[]")
  muteRoleId String? // optional role used by /mute when set
  updatedAt  DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model AdminUser {
  discordId      String   @id
  username       String
  globalName     String?
  avatarUrl      String?
  // Discord OAuth2 access token; used only to list the user's manageable guilds
  // via /users/@me/guilds. Stored plaintext; treat the DB as confidential. If
  // Discord returns 401 we drop the session and force a re-login (see
  // src/guild-permissions.ts and src/routes/admin/guilds.ts).
  accessToken    String
  tokenExpiresAt DateTime
  lastSeenAt     DateTime @default(now())

  sessions Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [discordId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Singleton row (id = 1) updated by the bot every ~30s via /bot/heartbeat.
// /health uses updatedAt to compute heartbeat age and surface bot liveness.
model BotHeartbeat {
  id        Int      @id @default(1)
  updatedAt DateTime @updatedAt @default(now())
}

// GDPR data-export job. The collector runs synchronously when /me/data-export
// is called and stores the resulting payload (or, in a future iteration, a
// signed URL to a generated archive) so the user can re-fetch it.
model DataExportJob {
  id           String    @id @default(uuid())
  userId       String
  guildId      String?
  requestedAt  DateTime  @default(now())
  completedAt  DateTime?
  fileUrl      String?   @db.VarChar(2048)
  status       String    @default("pending") @db.VarChar(16)

  guild        Guild?    @relation(fields: [guildId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

// GDPR data-delete request. Two-step: the user calls /me/data-delete to
// receive a confirmation token, then DMs /me/data-delete/confirm with the
// token, at which point the API wipes user-scoped rows in a transaction.
model DataDeleteRequest {
  id                  String    @id @default(uuid())
  userId              String
  guildId             String?
  requestedAt         DateTime  @default(now())
  confirmedAt         DateTime?
  completedAt         DateTime?
  confirmationToken   String    @db.VarChar(64)
  status              String    @default("pending") @db.VarChar(16)

  guild               Guild?    @relation(fields: [guildId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

// ─── Invite tracker (v0.41.0) ────────────────────────────────────────

// Mirror of Discord's per-guild invite codes. The bot upserts these from the
// guild.invites cache on InviteCreate / InviteDelete / refresh; we use them to
// resolve which invite a joining member used (by diffing pre/post `uses`
// counters) and to drive the leaderboard.
model InviteCode {
  code      String    @id
  guildId   String
  inviterId String?
  channelId String?
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// One row per (guild, user) join recorded by the bot. `inviterId` and
// `inviteCode` are populated when the bot can identify the inviter from the
// pre/post-join invite diff. `leftAt` is set on GuildMemberRemove; if the gap
// between `joinedAt` and `leftAt` is shorter than FAKE_INVITE_GRACE_HOURS,
// `isFake` is flipped so the leaderboard can discount the inviter.
model MemberInvite {
  guildId    String
  userId     String
  inviterId  String?
  inviteCode String?
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  isFake     Boolean   @default(false)

  guild      Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, inviterId])
}

// Per-(guild, inviteCode, roleId) rule. When a member joins via `inviteCode`,
// the bot auto-grants `roleId`. Multiple roles may be configured per code.
model InviteGatedRole {
  id         String @id @default(uuid())
  guildId    String
  inviteCode String
  roleId     String

  guild      Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, inviteCode, roleId])
  @@index([guildId])
}

// Per-guild auto-reaction rule. When a non-bot message in `channelId` (or any
// channel if null) matches `pattern` (literal substring or regex per `isRegex`,
// optionally case-sensitive), the bot reacts with each of `emojis` (unicode or
// `<a?:name:id>` custom-emoji syntax) in order. Max 20 rules per guild, 3
// emojis per rule (Discord caps reactions and we throttle to be polite).
model AutoReactionRule {
  id            String   @id @default(uuid())
  guildId       String
  channelId     String?
  pattern       String   @db.VarChar(200)
  isRegex       Boolean  @default(false)
  caseSensitive Boolean  @default(false)
  emojis        String[]
  enabled       Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())

  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, enabled])
}

// Per-guild link-safety configuration. Extends automod with a domain
// allowlist/blocklist, optional shortener expansion, optional Google Safe
// Browsing reputation lookup, and a configurable action to take when a
// posted URL fails the policy.
model LinkSafetyConfig {
  guildId          String   @id
  enabled          Boolean  @default(false)
  // 'allowlist' | 'blocklist'
  mode             String   @default("blocklist") @db.VarChar(16)
  // 'none' | 'delete' | 'warn' | 'mute' | 'kick'
  action           String   @default("delete") @db.VarChar(16)
  muteMinutes      Int      @default(10)
  notifyChannelId  String?
  expandShorteners Boolean  @default(true)
  gsbCheck         Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Per-guild allow- or block-listed domain. The bot's link-safety scanner
// looks up the final domain of every URL in a message (after optional
// shortener expansion) against the matching list.
model LinkDomain {
  id      String   @id @default(uuid())
  guildId String
  domain  String   @db.VarChar(255)
  // 'allow' | 'block'
  kind    String   @db.VarChar(16)
  addedBy String
  addedAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, domain, kind])
  @@index([guildId, kind])
}

// Per-guild data-retention policy. Each *Days field, when set, bounds the
// horizon (in days) for that table; the daily pruner deletes rows older than
// the configured horizon. `redactPii` toggles audit-log user-ID redaction
// on dashboard reads (see util/getRedactedUserId in apps/api).
model RetentionPolicy {
  guildId         String   @id
  modActionsDays  Int?
  modLogsDays     Int?
  transcriptDays  Int?
  snapshotDays    Int?
  auditLogDays    Int?
  redactPii       Boolean  @default(false)
  updatedAt       DateTime @updatedAt @default(now())

  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Per-guild application form (e.g. "Staff application", "Partner application").
// Admins author a form once, define up to 5 short/paragraph questions, and
// members run /apply <slug> to fill out a Discord modal. Submissions land in
// `reviewChannelId` as an embed with Approve/Reject buttons.
model OnboardingForm {
  id               String   @id @default(uuid())
  guildId          String
  slug             String   @db.VarChar(48)
  name             String   @db.VarChar(120)
  description      String?  @db.VarChar(500)
  // [{ label, placeholder?, required, maxLength, style: 'short'|'paragraph' }]
  questions        Json
  reviewChannelId  String?
  approveRoleId    String?
  approveDmMessage String?  @db.VarChar(2000)
  rejectDmTemplate String?  @db.VarChar(2000)
  enabled          Boolean  @default(true)
  createdBy        String
  createdAt        DateTime @default(now())

  guild        Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([guildId, slug])
  @@index([guildId])
}

// One member submission against an OnboardingForm. The bot persists the
// answers verbatim ({label: answer}) and tracks review state.
model Application {
  id              String    @id @default(uuid())
  guildId         String
  formId          String
  userId          String
  // { [questionLabel]: answer } captured from the Discord modal at submit time.
  answers         Json
  status          String    @default("pending") @db.VarChar(16)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?   @db.VarChar(500)
  reviewMessageId String?
  createdAt       DateTime  @default(now())

  guild Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  form  OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([guildId, status, createdAt])
}

// Per-guild Tamagotchi-style pet. Stats decay over time (see scheduler); the
// pet earns XP from member interactions which drives evolution through the
// stages defined in the bot's pet-state util.
model ServerPet {
  guildId       String   @id
  name          String   @default("Pixel") @db.VarChar(48)
  stage         String   @default("egg") @db.VarChar(16)
  xp            Int      @default(0)
  hunger        Int      @default(80)
  happiness     Int      @default(80)
  energy        Int      @default(80)
  lastUpdatedAt DateTime @updatedAt @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Audit ledger of every interaction with the server pet. Powers per-user
// cooldowns (feed: 30s, play: 5m, pet: 24h) and the 24h top-feeder board.
model PetInteraction {
  id            String   @id @default(uuid())
  guildId       String
  userId        String
  kind          String   @db.VarChar(16) // feed | play | pet
  xpAwarded     Int
  currencySpent Int      @default(0)
  at            DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, at])
  @@index([guildId, at])
}

// Per-(guild,user) profile customization. Stores the user's bio (markdown),
// chosen accent color (#RRGGBB) used to tint the /profile and /userinfo
// embeds, and a favorite quote line. Badges are tracked separately via
// UserBadge so they can be awarded by mods or unlocked via achievements.
model UserProfile {
  guildId       String
  userId        String
  bio           String?  @db.VarChar(400)
  accentColor   String?  @db.VarChar(7)
  favoriteQuote String?  @db.VarChar(200)
  updatedAt     DateTime @default(now()) @updatedAt

  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
}

// Per-(guild, user) fishing skill record. XP and level are advanced by the
// /fish cast → resolve flow. `casts` is a lifetime counter for the user
// (resolved + abandoned).
model FishingSkill {
  guildId String
  userId  String
  xp      Int    @default(0)
  level   Int    @default(1)
  casts   Int    @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
}

// A badge that can be awarded to members in a guild. Slug is the stable
// identifier used by slash commands; name/emoji/description drive how the
// badge is rendered on the profile card.
model ProfileBadge {
  id          String   @id @default(uuid())
  guildId     String
  slug        String   @db.VarChar(48)
  name        String   @db.VarChar(64)
  emoji       String   @db.VarChar(64)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now())

  guild      Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userBadges UserBadge[]

  @@unique([guildId, slug])
  @@index([guildId])
}

// Join table: a badge awarded to a specific (guild,user). `awardedBy` is the
// moderator's user id when granted via slash command; null when awarded by
// an automated system (e.g. achievements).
model UserBadge {
  guildId    String
  userId     String
  badgeId    String
  awardedAt  DateTime @default(now())
  awardedBy  String?

  guild Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  badge ProfileBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([guildId, userId, badgeId])
  @@index([guildId, userId])
}

// Per-guild achievement catalogue. `kind` selects the activity counter the
// bot evaluates on relevant events (messages | voice_minutes | level |
// reactions | stickers | custom). Custom achievements are only awarded via
// explicit API/CLI calls.
model Achievement {
  id             String   @id @default(uuid())
  guildId        String
  slug           String   @db.VarChar(48)
  name           String   @db.VarChar(80)
  description    String   @db.VarChar(300)
  emoji          String   @default("🏆") @db.VarChar(64)
  kind           String   @db.VarChar(32)
  threshold      Int      @default(1)
  badgeSlug      String?
  currencyReward Int      @default(0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  guild            Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userAchievements UserAchievement[]

  @@unique([guildId, slug])
  @@index([guildId, kind, enabled])
}

// One row per (guild, user, achievement) when the user unlocks it. Acts as
// the idempotency ledger — the evaluator skips any achievement already
// present here.
model UserAchievement {
  guildId          String
  userId           String
  achievementId    String
  unlockedAt       DateTime @default(now())
  progressAtUnlock Int

  guild       Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([guildId, userId, achievementId])
  @@index([guildId, userId])
}

// Per-guild quest template. Each template defines an objective (kind +
// targetCount) and the rewards a member earns when they complete it. The
// `cadence` is 'daily' or 'weekly'; the API auto-assigns enabled templates
// to a member as `UserQuest` rows when they first request their quest list
// in a period.
model QuestTemplate {
  id              String   @id @default(uuid())
  guildId         String
  slug            String   @db.VarChar(48)
  name            String   @db.VarChar(120)
  description     String?  @db.VarChar(500)
  // One of: 'send_messages' | 'react_messages' | 'send_in_channel' |
  // 'voice_minutes' | 'send_image' | 'complete_other_quest'.
  kind            String   @db.VarChar(32)
  targetCount     Int      @default(1)
  targetChannelId String?
  // 'daily' | 'weekly'
  cadence         String   @db.VarChar(8)
  rewardCurrency  Int      @default(0)
  rewardXp        Int      @default(0)
  rewardRoleId    String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  guild      Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userQuests UserQuest[]

  @@unique([guildId, slug])
  @@index([guildId, cadence, enabled])
}

// Per-(member, template) quest assignment for one period. `expiresAt` is
// 24h after `periodStartedAt` for dailies and 7d for weeklies; the
// scheduler hourly tick deletes unclaimed expired rows so a fresh
// assignment can be created on the member's next /quest list.
model UserQuest {
  id              String    @id @default(uuid())
  guildId         String
  userId          String
  templateId      String
  progress        Int       @default(0)
  completedAt     DateTime?
  claimedAt       DateTime?
  periodStartedAt DateTime  @default(now())
  expiresAt       DateTime

  guild    Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  template QuestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, templateId, periodStartedAt])
  @@index([guildId, userId, expiresAt])
}

// Peer-to-peer marketplace listings. A seller posts an item from their
// inventory at a fixed price; the item moves into escrow (off the seller's
// inventory row) until either a buyer claims it (status='sold'), the seller
// cancels (status='cancelled'), or 7 days elapse (status='expired'). The
// scheduler's hourly tick sweeps `expiresAt` and returns escrow items to the
// original seller.
model MarketListing {
  id          String    @id @default(uuid())
  guildId     String
  sellerId    String
  itemId      String
  quantity    Int       @default(1)
  priceCents  Int
  listedAt    DateTime  @default(now())
  expiresAt   DateTime
  status      String    @default("active") @db.VarChar(16)
  buyerId     String?
  completedAt DateTime?

  guild Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  item  ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([guildId, status, listedAt])
  @@index([guildId, sellerId])
}

// Per-guild marketplace config. Disabling the marketplace blocks new listing
// creation but leaves existing listings intact (they continue to be claimable
// until natural expiry). `minTenureDays` is the scam-guard floor: members
// must have joined the server at least N days ago to post a listing.
model MarketConfig {
  guildId                  String  @id
  enabled                  Boolean @default(true)
  minTenureDays            Int     @default(1)
  maxActiveListingsPerUser Int     @default(10)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Open-bid timed auctions on shop/inventory items. The seller escrows the
// item up-front; bidders' currency is escrowed on each bid and refunded when
// they are outbid. Settlement happens via the scheduler when endsAt passes:
// the winner gets the item, the seller gets the funds. Anti-snipe extends
// endsAt by 60s when a bid lands in the last 60s.
//
// status: 'active' | 'ended' | 'cancelled'
model Auction {
  id                String       @id @default(uuid())
  guildId           String
  sellerId          String
  itemId            String
  quantity          Int          @default(1)
  startPriceCents   Int
  minIncrementCents Int          @default(1)
  // Highest bid so far (0 if no bids placed yet).
  currentBidCents   Int          @default(0)
  // Highest bidder's user id (null if no bids placed).
  currentBidderId   String?
  endsAt            DateTime
  status            String       @default("active") @db.VarChar(16)
  createdAt         DateTime     @default(now())
  settledAt         DateTime?

  guild Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  item  ShopItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  bids  AuctionBid[]

  @@index([guildId, status, endsAt])
}

// One bid per row. `escrowedCents` records the funds locked at the moment
// the bid was placed (== amountCents at bid time). When outbid the row is
// refunded and `refundedAt` is stamped so the settlement step can skip it.
model AuctionBid {
  id            String    @id @default(uuid())
  auctionId     String
  userId        String
  amountCents   Int
  escrowedCents Int
  placedAt      DateTime  @default(now())
  refundedAt    DateTime?

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, placedAt])
}

// One row per possible drop in the guild's fishing table. The /fish resolve
// flow picks a row via weighted random across rows whose minLevel ≤ player
// level. Optional `itemId` links to a ShopItem so successful catches deposit
// into the player's existing inventory.
model FishingDrop {
  id           String   @id @default(uuid())
  guildId      String
  slug         String   @db.VarChar(48)
  itemId       String?
  name         String   @db.VarChar(120)
  emoji        String   @default("🐟") @db.VarChar(64)
  minLevel     Int      @default(1)
  weight       Int      @default(10)
  currencyMin  Int      @default(0)
  currencyMax  Int      @default(0)
  xpReward     Int      @default(5)
  enabled      Boolean  @default(true)

  guild Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  item  ShopItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([guildId, slug])
  @@index([guildId, minLevel, enabled])
}

// An in-flight or resolved cast. `resolvesAt` is `startedAt + 30s`; the
// /fish reel-in button (or the scheduler auto-resolve sweep) flips
// `resolved=true` and writes the chosen drop + rewards.
model FishingCast {
  id              String   @id @default(uuid())
  guildId         String
  userId          String
  startedAt       DateTime @default(now())
  resolvesAt      DateTime
  resolved        Boolean  @default(false)
  dropId          String?
  currencyEarned  Int      @default(0)
  xpEarned        Int      @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, resolved])
  @@index([resolvesAt])
}
