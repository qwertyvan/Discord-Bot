# ─── Discord ───
# Bot token from https://discord.com/developers/applications → Bot
DISCORD_TOKEN=
# Application (client) id — same page, top of OAuth2 settings
DISCORD_CLIENT_ID=
# Optional: register slash commands only to this guild during dev (instant updates).
# Leave blank to register globally (can take up to 1 hour to propagate).
DEV_GUILD_ID=

# ─── API ───
API_BASE_URL=http://localhost:4000
# Must match BOT_API_TOKEN in apps/api/.env
BOT_API_TOKEN=replace-me-with-a-long-random-string

# ─── Misc ───
NODE_ENV=development
LOG_LEVEL=info
