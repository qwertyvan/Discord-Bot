# ─── API ───
# Internal URL the Next.js server uses to reach the API (server-to-server).
# In Docker this would be e.g. http://api:4000.
API_BASE_URL=http://localhost:4000

# Public URL the browser uses for OAuth redirects.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Cookie name — must match SESSION_COOKIE_NAME in apps/api/.env.
SESSION_COOKIE_NAME=db_session
